{
  "setting_track_length": {
    "type": "int",
    "description": "跑道长度",
    "default": 20
  },
  "setting_random_min_length": {
    "type": "int",
    "description": "随机位置最小值",
    "default": 0
  },
  "setting_random_max_length": {
    "type": "int",
    "description": "随机位置最大值",
    "default": 15
  },
  "base_move_min": {
    "type": "int",
    "description": "基础移动最小值",
    "default": 1
  },
  "base_move_max": {
    "type": "int",
    "description": "基础移动最大值",
    "default": 3
  },
  "max_player": {
    "type": "int",
    "description": "最多玩家数",
    "default": 8
  },
  "min_player": {
    "type": "int",
    "description": "最少玩家数（手动及自动开赛）",
    "default": 2
  },
  "setting_over_time": {
    "type": "int",
    "description": "允许重置的等待秒数",
    "default": 120
  },
  "event_rate": {
    "type": "int",
    "description": "事件概率（千分比）",
    "default": 450
  },
  "round_interval": {
    "type": "float",
    "description": "回合间隔（秒）",
    "default": 6.0
  },
  "max_rounds": {
    "type": "int",
    "description": "回合上限",
    "default": 100
  },
  "image_mode": {
    "type": "bool",
    "description": "图片播报（需要 AstrBot 渲染服务）",
    "default": false
  },
  "enable_ai_event_generator": {
    "type": "bool",
    "description": "使用内置 AI，一句话生成事件",
    "default": false,
    "hint": "启用后在工作台旁显示 AI 对话，生成事件包后可导入或保存。"
  },
  "ai_event_provider_id": {
    "type": "string",
    "description": "事件生成使用的模型",
    "default": "",
    "_special": "select_provider",
    "hint": "优先调用此处指定的 AstrBot 模型；留空使用 AstrBot 默认聊天模型。"
  }
}
